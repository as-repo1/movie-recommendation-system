[Desktop Entry]
Name=RecLens
GenericName=Movie Recommendation & Discovery Engine
Comment=Explore, search, and discover movies with an ultra-fast in-process AI recommendation engine
Exec=reclens %U
Icon=org.reclens.RecLens
Terminal=false
Type=Application
Categories=AudioVideo;Video;Player;GTK;GNOME;
Keywords=Movie;Film;Recommendation;AI;Cinema;TMDB;Discovery;
StartupWMClass=org.reclens.RecLens
MimeType=x-scheme-handler/reclens;
Actions=Search;Watchlist;

[Desktop Action Search]
Name=Instant Search
Exec=reclens search
Icon=system-search-symbolic

[Desktop Action Watchlist]
Name=View Watchlist
Exec=reclens watchlist
Icon=view-paged-symbolic
