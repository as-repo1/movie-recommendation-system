# ── Movie API Keys ────────────────────────────────────────────────────────────
# Tier 1: TMDB (best quality, free key from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Tier 2: OMDb (free 1000 req/day key from https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# Base URL the frontend uses to call the API (change for production)
VITE_API_URL=http://localhost:8000

# ── Database Settings ─────────────────────────────────────────────────────────
# For local run outside docker (assuming Postgres runs in docker with ports mapped):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cinematch
# For docker-compose runs, this is handled automatically via environment overrides.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/cinematch

